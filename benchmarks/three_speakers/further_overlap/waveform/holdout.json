        {
          "id": "0700",
          "target": "SSB07000265.wav",
          "enroll": "SSB07000003.wav",
          "text": "副省长何报翔立即要求省旅游局督促张家界市一查到底"
        },
        {
          "id": "0590",
          "target": "SSB05900401.wav",
          "enroll": "SSB05900043.wav",
          "text": "较二零一三年同期增长二十一万约百分之零九一"
